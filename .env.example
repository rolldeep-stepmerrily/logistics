NODE_ENV=local
PORT=3001

# XState Sky Inspector — dev 환경에서 상태 시각화 활성화 (stately.ai 로 스트리밍, stdout URL 확인)
XSTATE_INSPECT=false

DATABASE_URL=postgresql://postgres:password@localhost:5433/logistics?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380

KAFKA_BROKERS=localhost:9093
KAFKA_CLIENT_ID=logistics
KAFKA_GROUP_ID=logistics-consumer

JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d
