{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@@decorators": ["src/common/decorators/index"],
      "@@entities": ["src/common/entities/index"],
      "@@exceptions": ["src/common/exceptions/index"],
      "@@prisma": ["src/generated/prisma/client"],
      "@@cqrs": ["src/common/cqrs/index"],
      "@@redis": ["src/common/redis/index"],
      "@@kafka": ["src/common/kafka/index"],
      "@@guards": ["src/common/guards/index"],
      "@@db": ["src/common/prisma/index"],
      "@@state-machines": ["src/common/state-machines/index"]
    }
  }
}
